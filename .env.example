# 복사해서 .env로 쓰고 값을 채움. 이 파일에는 실제 값을 넣지 않음.
# Spring Boot는 아래 환경변수를 그대로 읽음 (application.yml에 기본값 없음).

# PostgreSQL (pgvector)
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Redis
SPRING_DATA_REDIS_HOST=
SPRING_DATA_REDIS_PORT=
SPRING_DATA_REDIS_PASSWORD=

# JWT 서명 키: Base64 32바이트 이상 (예: openssl rand -base64 48)
JWT_SECRET=

# 로그인 후 돌아갈 프론트 주소 (예: http://localhost:5173)
APP_FRONTEND_URL=

# 소셜 로그인
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
